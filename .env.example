# Supabase: Project Settings -> Database -> Connection string -> Session pooler -> URI
# Keep sslmode=require. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

APP_ENV=development
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true

# Assessment requirement: simulate 30 seconds of background work.
PROCESSING_DELAY_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=10
PROCESSING_LEASE_SECONDS=120
MAX_PROCESSING_ATTEMPTS=5
RETRY_BASE_SECONDS=5
